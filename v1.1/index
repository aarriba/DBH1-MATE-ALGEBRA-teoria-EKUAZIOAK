    function updateDeg2Sim() {
        var a = parseInt(document.getElementById('deg2-a-num').value, 10) || 0;
        var b = parseInt(document.getElementById('deg2-b-num').value, 10) || 0;
        var c = parseInt(document.getElementById('deg2-c-num').value, 10) || 0;

        var bSign = b >= 0 ? "+ " + b : "- " + Math.abs(b);
        var cSign = c >= 0 ? "+ " + c : "- " + Math.abs(c);
        document.getElementById('deg2-eq-display').innerText = a + "x² " + bSign + "x " + cSign + " = 0";

        var statusEl = document.getElementById('deg2-disc-status');
        var stepsContainer = document.getElementById('deg2-steps');

        if (a === 0) {
            statusEl.className = 'disc-info disc-negative';
            statusEl.innerText = translations[currentLang].invalidDeg2;
            stepsContainer.innerHTML = '';
            return;
        }

        var disc = (b * b) - (4 * a * c);
        var discText = "Δ = (" + b + ")² - 4·(" + a + ")·(" + c + ") = " + disc;

        if (disc > 0) {
            statusEl.className = 'disc-info disc-positive';
            statusEl.innerText = discText + " > 0 ➔ " + (currentLang === 'eu' ? 'Bi irtenbide erreal ezberdin' : 'Dos soluciones reales distintas');
            var x1 = ((-b + Math.sqrt(disc)) / (2 * a)).toFixed(2);
            var x2 = ((-b - Math.sqrt(disc)) / (2 * a)).toFixed(2);

            stepsContainer.innerHTML = 
                '<p>x = [ -(' + b + ') ± √' + disc + ' ] / (2·' + a + ')</p>' +
                '<p style="font-weight:bold; color:var(--primary); margin-top:5px;">x₁ = ' + (x1 % 1 === 0 ? parseInt(x1, 10) : x1) + ' | x₂ = ' + (x2 % 1 === 0 ? parseInt(x2, 10) : x2) + '</p>';
        } else if (disc === 0) {
            statusEl.className = 'disc-info disc-zero';
            statusEl.innerText = discText + " = 0 ➔ " + (currentLang === 'eu' ? 'Irtenbide bikoitz bakarra' : 'Una solución real doble');
            var x = ((-b) / (2 * a)).toFixed(2);

            stepsContainer.innerHTML = 
                '<p>x = -(' + b + ') / (2·' + a + ')</p>' +
                '<p style="font-weight:bold; color:var(--primary); margin-top:5px;">x₁ = x₂ = ' + (x % 1 === 0 ? parseInt(x, 10) : x) + '</p>';
        } else {
            statusEl.className = 'disc-info disc-negative';
            statusEl.innerText = discText + " < 0 ➔ " + (currentLang === 'eu' ? 'Ez dago irtenbide errealik' : 'Sin soluciones reales');
            stepsContainer.innerHTML = '<p style="color:var(--error);">' + (currentLang === 'eu' ? 'Erro karratua ezin da zenbaki errealetan ebatzi.' : 'La raíz cuadrada negativa no tiene solución real.') + '</p>';
        }

        drawParabola();
    }

    // Dibuja la Parábola y marca en ROJO los puntos de corte con y=0 con x= [solución 1] y x'= [solución 2]
    function drawParabola() {
        var canvas = document.getElementById('deg2Canvas');
        if (!canvas || !canvas.getContext) return;
        var ctx = canvas.getContext('2d');

        var a = parseInt(document.getElementById('deg2-a-num').value, 10) || 1;
        var b = parseInt(document.getElementById('deg2-b-num').value, 10) || 0;
        var c = parseInt(document.getElementById('deg2-c-num').value, 10) || 0;

        ctx.clearRect(0, 0, canvas.width, canvas.height);

        var originX = canvas.width / 2;
        var originY = canvas.height / 2;
        var scale = 15;

        // Ejes de Coordenadas
        ctx.beginPath();
        ctx.strokeStyle = '#cbd5e0';
        ctx.lineWidth = 1;
        ctx.moveTo(0, originY); ctx.lineTo(canvas.width, originY);
        ctx.moveTo(originX, 0); ctx.lineTo(originX, canvas.height);
        ctx.stroke();

        if (a === 0) return;

        // Trazado de la Parábola
        ctx.beginPath();
        ctx.strokeStyle = '#2b6cb0';
        ctx.lineWidth = 2.5;

        var first = true;
        for (var pixelX = 0; pixelX <= canvas.width; pixelX++) {
            var x = (pixelX - originX) / scale;
            var y = a * x * x + b * x + c;
            var pixelY = originY - (y * scale);

            if (first) {
                ctx.moveTo(pixelX, pixelY);
                first = false;
            } else {
                ctx.lineTo(pixelX, pixelY);
            }
        }
        ctx.stroke();

        // Puntos de corte con y = 0
        var disc = (b * b) - (4 * a * c);
        if (disc >= 0) {
            var sol1 = (-b + Math.sqrt(disc)) / (2 * a);
            var sol2 = (-b - Math.sqrt(disc)) / (2 * a);

            // Primer punto de corte
            var p1X = originX + (sol1 * scale);
            ctx.beginPath();
            ctx.fillStyle = '#e53e3e';
            ctx.arc(p1X, originY, 6, 0, 2 * Math.PI);
            ctx.fill();

            ctx.font = 'bold 11px sans-serif';
            var txt1 = "x = " + (sol1 % 1 === 0 ? sol1 : sol1.toFixed(2));
            ctx.fillText(txt1, p1X - 15, originY - 10);

            // Segundo punto de corte (si es distinto)
            if (disc > 0) {
                var p2X = originX + (sol2 * scale);
                ctx.beginPath();
                ctx.fillStyle = '#e53e3e';
                ctx.arc(p2X, originY, 6, 0, 2 * Math.PI);
                ctx.fill();

                var txt2 = "x' = " + (sol2 % 1 === 0 ? sol2 : sol2.toFixed(2));
                ctx.fillText(txt2, p2X - 15, originY + 20);
            }
        }
    }

