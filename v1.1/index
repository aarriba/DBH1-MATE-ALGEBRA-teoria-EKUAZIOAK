        } else {
            fb.className = 'feedback incorrect';
            fb.innerText = t.incorrectMsg;
        }
    }

    var q2Sol1 = 2, q2Sol2 = 3;
    function generateQuiz2() {
        q2Sol1 = Math.floor(Math.random() * 6) - 2;
        q2Sol2 = Math.floor(Math.random() * 6) - 2;

        var a = 1;
        var b = -(q2Sol1 + q2Sol2);
        var c = q2Sol1 * q2Sol2;

        var bSign = b >= 0 ? "+ " + b : "- " + Math.abs(b);
        var cSign = c >= 0 ? "+ " + c : "- " + Math.abs(c);

        document.getElementById('q2-eq-text').innerText = "x² " + bSign + "x " + cSign + " = 0";
        document.getElementById('q2-ans1').value = '';
        document.getElementById('q2-ans2').value = '';
        document.getElementById('q2-feedback').className = 'feedback';
    }

    function checkQuiz2() {
        var u1 = parseFloat(document.getElementById('q2-ans1').value);
        var u2 = parseFloat(document.getElementById('q2-ans2').value);
        var fb = document.getElementById('q2-feedback');
        var t = translations[currentLang];

        var matchDirect = (u1 === q2Sol1 && u2 === q2Sol2);
        var matchCross = (u1 === q2Sol2 && u2 === q2Sol1);

        if (matchDirect || matchCross) {
            fb.className = 'feedback correct';
            fb.innerText = t.correctMsg;
        } else {
            fb.className = 'feedback incorrect';
            fb.innerText = t.incorrectMsg;
        }
    }

    window.onload = function() {
        updateDeg1Sim();
        updateDeg2Sim();
        generateQuiz1();
        generateQuiz2();
