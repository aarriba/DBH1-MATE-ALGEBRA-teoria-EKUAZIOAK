    // Sincronización para Grado 1
    function syncDeg1(param, source) {
        var num = document.getElementById('deg1-' + param + '-num');
        var range = document.getElementById('deg1-' + param + '-range');
        if (source === 'num') {
            range.value = Math.round(num.value);
        } else {
            num.value = range.value;
        }
        updateDeg1Sim();
    }

    function updateDeg1Sim() {
        var a = parseInt(document.getElementById('deg1-a-num').value, 10) || 0;
        var b = parseInt(document.getElementById('deg1-b-num').value, 10) || 0;
        var c = parseInt(document.getElementById('deg1-c-num').value, 10) || 0;

        var bSign = b >= 0 ? "+ " + b : "- " + Math.abs(b);
        document.getElementById('deg1-eq-display').innerText = a + "x " + bSign + " = " + c;

        var stepsContainer = document.getElementById('deg1-steps');
        if (a === 0) {
            stepsContainer.innerHTML = '<p style="color:var(--error); font-weight:bold;">' + (currentLang === 'eu' ? 'a-k ezin du 0 izan (ez dago x-rik).' : 'a no puede ser 0.') + '</p>';
            return;
        }

        var rhs = c - b;
        var rhsSign = b >= 0 ? c + " - " + b : c + " + " + Math.abs(b);
        var sol = (rhs / a).toFixed(2);

        stepsContainer.innerHTML = 
            '<p><strong>Paso 1 (Pasar b):</strong> ' + a + 'x = ' + rhsSign + ' ➔ ' + a + 'x = ' + rhs + '</p>' +
            '<p><strong>Paso 2 (Despejar "x"):</strong> x = ' + rhs + ' / ' + a + '</p>' +
            '<p style="font-size:1.1rem; color:var(--primary); margin-top:5px;"><strong>Emaitza / Resultado:</strong> x = <strong>' + (sol % 1 === 0 ? parseInt(sol, 10) : sol) + '</strong></p>';

        drawDeg1Graph();
    }

    // Dibuja la RECTA NEGRA en un eje de coordenadas y marca con ROJO el punto de corte con y=0
    function drawDeg1Graph() {
        var canvas = document.getElementById('deg1Canvas');
        if (!canvas || !canvas.getContext) return;
        var ctx = canvas.getContext('2d');

        var a = parseInt(document.getElementById('deg1-a-num').value, 10) || 1;
        var b = parseInt(document.getElementById('deg1-b-num').value, 10) || 0;
        var c = parseInt(document.getElementById('deg1-c-num').value, 10) || 0;

        ctx.clearRect(0, 0, canvas.width, canvas.height);

        var originX = canvas.width / 2;
        var originY = canvas.height / 2;
        var scale = 15;

        // Dibuja los Ejes de Coordenadas principales
        ctx.beginPath();
        ctx.strokeStyle = '#cbd5e0';
        ctx.lineWidth = 1;
        ctx.moveTo(0, originY); ctx.lineTo(canvas.width, originY);
        ctx.moveTo(originX, 0); ctx.lineTo(originX, canvas.height);
        ctx.stroke();

        // Marcas numéricas pequeñas en los ejes
        ctx.font = '9px sans-serif';
        ctx.fillStyle = '#a0aec0';
        for (var i = -10; i <= 10; i += 2) {
            if (i !== 0) {
                ctx.fillText(i, originX + i * scale - 4, originY + 12);
                ctx.fillText(i, originX - 14, originY - i * scale + 3);
            }
        }

        if (a === 0) return;

        // Dibuja la Recta en NEGRO
        ctx.beginPath();
        ctx.strokeStyle = '#000000';
        ctx.lineWidth = 2.5;

        var xLeft = -15;
        var yLeft = a * xLeft + (b - c);
        var pxLeft = originX + (xLeft * scale);
        var pyLeft = originY - (yLeft * scale);

        var xRight = 15;
        var yRight = a * xRight + (b - c);
        var pxRight = originX + (xRight * scale);
        var pyRight = originY - (yRight * scale);

        ctx.moveTo(pxLeft, pyLeft);
        ctx.lineTo(pxRight, pyRight);
        ctx.stroke();

        // Solución x = (c - b) / a  -> Punto de corte con y = 0
        var solX = (c - b) / a;
        var pSolX = originX + (solX * scale);
        var pSolY = originY;

        // Marcar el punto de corte en ROJO
        ctx.beginPath();
        ctx.fillStyle = '#e53e3e';
        ctx.arc(pSolX, pSolY, 6, 0, 2 * Math.PI);
        ctx.fill();

        // Texto informativo en ROJO x = [solución]
        var solText = "x = " + (solX % 1 === 0 ? solX : solX.toFixed(2));
        ctx.font = 'bold 12px sans-serif';
        ctx.fillStyle = '#e53e3e';
        ctx.fillText(solText, pSolX - 15, pSolY - 12);
    }

    // Sincronización para Grado 2
    function syncDeg2(param, source) {
        var num = document.getElementById('deg2-' + param + '-num');
        var range = document.getElementById('deg2-' + param + '-range');
        if (source === 'num') {
            range.value = Math.round(num.value);
